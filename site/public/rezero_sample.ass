Dialogue: 0,0:00:03.16,0:00:06.16,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Sanki... {\alpha&HFF&\t(1340,1,\alpha&H00&)}beni öldürmenize izin veririm de...
Dialogue: 0,0:00:12.92,0:00:15.31,Subaru,Subaru,0,0,0,,Gerçekten de çöl.
Dialogue: 0,0:00:31.55,0:00:33.61,Subaru,Subaru,0,0,0,,B-Bu şey de neyin nesi?!
Dialogue: 0,0:00:41.58,0:00:42.48,Subaru,Subaru,0,0,0,,Olamaz!
Dialogue: 0,0:01:02.67,0:01:04.25,Subaru,Subaru,0,0,0,,N'oluyor be?..
Dialogue: 0,0:01:04.74,0:01:07.83,Subaru,Subaru,0,0,0,,Tam olarak ne yapmamı istiyorsun?..
Dialogue: 0,0:01:08.39,0:01:12.06,Subaru,Subaru,0,0,0,,Cevap ver, Natsuki Subaru!
Dialogue: 0,0:01:16.63,0:01:18.54,Subaru,Subaru,0,0,0,,Hay—Hayır!
Dialogue: 0,0:01:21.56,0:01:25.27,Subaru,Subaru,0,0,0,,Biri... Biri bana yardım etsin!
Dialogue: 0,0:01:51.32,0:01:53.64,Subaru,Subaru,0,0,0,,Çölün altı mı?
Dialogue: 0,0:02:05.33,0:02:06.40,Subaru,Subaru,0,0,0,,Siktir...
Dialogue: 0,0:02:06.40,0:02:08.53,Subaru,Subaru,0,0,0,,Siktir! Siktir! Siktir!
Dialogue: 0,0:02:08.53,0:02:10.37,Subaru,Subaru,0,0,0,,N'oluyor?! N'oluyor?!
Dialogue: 0,0:02:10.37,0:02:12.73,Subaru,Subaru,0,0,0,,Neler oluyor burada?!
Dialogue: 0,0:03:50.41,0:03:53.31,Subaru,Subaru,0,0,0,,Bununla üç etti.
Dialogue: 0,0:03:57.29,0:03:58.99,Subaru,Subaru,0,0,0,,Ne kadar geçti acaba?
Dialogue: 0,0:03:59.44,0:04:01.74,Subaru,Subaru,0,0,0,,Üç saat mi dört saat mi?..
Dialogue: 0,0:04:16.71,0:04:17.86,Subaru,Subaru,0,0,0,,Hay!..
Dialogue: 0,0:04:44.70,0:04:46.26,Subaru,Subaru,0,0,0,,Saçmalama!
Dialogue: 0,0:04:46.60,0:04:50.32,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Neden... {\alpha&HFF&\t(1270,1,\alpha&H00&)}Neden yoluma çıkıyorsun?!
Dialogue: 0,0:04:54.85,0:04:58.04,Subaru,Subaru,0,0,0,,Şerefsiz! Taşak geçme lan benimle!
Dialogue: 0,0:05:02.17,0:05:03.03,Subaru,Subaru,0,0,0,,Ha?
Dialogue: 0,0:05:10.96,0:05:13.76,Subaru,Subaru,0,0,0,,O kadar kaçtım...
Dialogue: 0,0:05:14.53,0:05:16.67,Subaru,Subaru,0,0,0,,kaçtım... kaçtım...
Dialogue: 0,0:05:21.02,0:05:22.05,Subaru,Subaru,0,0,0,,Yeter.
Dialogue: 0,0:05:23.53,0:05:25.29,Subaru,Subaru,0,0,0,,Öldüreceğim.
Dialogue: 0,0:05:35.60,0:05:38.30,Subaru,Subaru,0,0,0,,Kim olduğunu bilmesem de...
Dialogue: 0,0:05:39.86,0:05:41.95,Subaru,Subaru,0,0,0,,öldüreceğim.
Dialogue: 0,0:05:41.95,0:05:45.15,Subaru,Subaru,0,0,0,,Yemin olsun ki öldüreceğim.
Dialogue: 0,0:05:45.60,0:05:49.25,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(1380,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(2530,1,\alpha&H00&)}Öldüreceğim...
Dialogue: 0,0:05:49.91,0:05:51.12,Subaru,Subaru,0,0,0,,Öldüreceğim...
Dialogue: 0,0:05:51.36,0:05:52.29,Subaru,Subaru,0,0,0,,Öldüreceğim...
Dialogue: 0,0:05:52.60,0:05:53.45,Subaru,Subaru,0,0,0,,Öldüreceğim...
Dialogue: 0,0:05:53.75,0:05:54.62,Subaru,Subaru,0,0,0,,Öldüreceğim...
Dialogue: 0,0:05:54.88,0:05:55.79,Subaru,Subaru,0,0,0,,Öldüreceğim...
Dialogue: 0,0:05:56.00,0:05:56.96,Subaru,Subaru,0,0,0,,Öldüreceğim...
Dialogue: 0,0:05:57.12,0:05:58.33,Subaru,Subaru,0,0,0,,Öldüreceğim...
Dialogue: 0,0:05:58.92,0:06:01.85,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(1380,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(2330,1,\alpha&H00&)}Öldüreceğim...
Dialogue: 0,0:06:01.85,0:06:07.51,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(790,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(1560,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(2240,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(2760,1,\alpha&H00&)}Öldüreceğim...\N{\alpha&HFF&\t(3340,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(3900,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(4360,1,\alpha&H00&)}Öldüreceğim... {\alpha&HFF&\t(4920,1,\alpha&H00&)}Öldüreceğim...
Dialogue: 0,0:06:38.45,0:06:42.29,Subaru,Subaru,0,0,0,,Shaula suçlu değildi demek...
Dialogue: 0,0:06:45.77,0:06:48.47,Subaru,Subaru,0,0,0,,Beatrice ve Meili birer çocuk.
Dialogue: 0,0:06:48.64,0:06:49.72,Subaru,Subaru,0,0,0,,Kolay olacak.
Dialogue: 0,0:06:50.19,0:06:52.93,Subaru,Subaru,0,0,0,,Emilia bana karşı gardını indirmişti.
Dialogue: 0,0:06:53.33,0:06:57.06,Subaru,Subaru,0,0,0,,Bu durumda tehlikeli olanlar, Ram ve Echidna.
Dialogue: 0,0:06:57.52,0:06:59.21,Subaru,Subaru,0,0,0,,Julius da tabii.
Dialogue: 0,0:06:59.21,0:07:02.44,Subaru,Subaru,0,0,0,,Benden uzak bir yerde cehennemi\Nboylasa işime gelirdi de...
Dialogue: 0,0:07:03.31,0:07:04.44,Subaru,Subaru,0,0,0,,Ha?
Dialogue: 0,0:07:46.48,0:07:49.73,Subaru,Subaru,0,0,0,,Ortalıkta olmayanlar, Emilia ve Beatrice.
Dialogue: 0,0:07:49.73,0:07:51.94,Subaru,Subaru,0,0,0,,O ikisinden hangisi beni—
Dialogue: 0,0:07:56.12,0:07:57.42,Subaru,Subaru,0,0,0,,Sen miydin?..
Dialogue: 0,0:08:10.91,0:08:12.48,Subaru,Subaru,0,0,0,,Peşimi bırak!
Dialogue: 0,0:08:12.48,0:08:15.26,Subaru,Subaru,0,0,0,,Seninle oynayacak vaktim yok!
Dialogue: 0,0:08:15.26,0:08:19.22,Subaru,Subaru,0,0,0,,Hayatta kalan herkesi öldürmem gerek!
Dialogue: 0,0:08:21.18,0:08:25.01,Subaru,Subaru,0,0,0,,Eğer yoluma çıkacaksan...
Dialogue: 0,0:08:39.79,0:08:40.60,Subaru,Subaru,0,0,0,,Hassiktir!
Dialogue: 0,0:08:40.73,0:08:43.41,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Siktir! {\alpha&HFF&\t(830,1,\alpha&H00&)}Siktir! {\alpha&HFF&\t(1310,1,\alpha&H00&)}Siktir! {\alpha&HFF&\t(1660,1,\alpha&H00&)}Siktir!
Dialogue: 0,0:08:43.41,0:08:46.08,Subaru,Subaru,0,0,0,,N'oluyor?! N'oluyor amına koyayım ya?!
Dialogue: 0,0:08:46.08,0:08:48.79,Subaru,Subaru,0,0,0,,Sen de diğer herkes de!..
Dialogue: 0,0:08:48.79,0:08:51.05,Subaru,Subaru,0,0,0,,cesetler de yaşayanlar da!..
Dialogue: 0,0:08:51.05,0:08:52.89,Subaru,Subaru,0,0,0,,Kafanızdan ne geçiyor?!
Dialogue: 0,0:08:52.89,0:08:54.18,Subaru,Subaru,0,0,0,,Amacınız ne?!
Dialogue: 0,0:08:54.60,0:08:57.43,Subaru,Subaru,0,0,0,,Hiçbirinizi gram siklemiyorum!
Dialogue: 0,0:08:57.89,0:09:01.39,Subaru,Subaru,0,0,0,,Herkes bir bir sorunlarını üstüme yıkıyor!
Dialogue: 0,0:09:01.39,0:09:04.14,Subaru,Subaru,0,0,0,,Kendi sorunlarınızdan başınızı\Nkaldıramıyorsanız...
Dialogue: 0,0:09:04.14,0:09:06.16,Subaru,Subaru,0,0,0,,Benim de!..
Dialogue: 0,0:09:07.16,0:09:10.52,Subaru,Subaru,0,0,0,,kendi sorunlarım başımdan aşkın!..
Dialogue: 0,0:09:18.22,0:09:22.19,Subaru,Subaru,0,0,0,,Beni boş verin gitsinsenize?..
Dialogue: 0,0:09:22.74,0:09:27.17,Subaru,Subaru,0,0,0,,Yalnız bıraksanız keşke!..
Dialogue: 0,0:09:38.00,0:09:39.02,Subaru,Subaru,0,0,0,,Sen—
Dialogue: 0,0:10:05.25,0:10:06.41,Subaru,Subaru,0,0,0,,Olamaz!
Dialogue: 0,0:10:06.41,0:10:08.12,Subaru,Subaru,0,0,0,,Ölmek istemiyorum!
Dialogue: 0,0:10:10.72,0:10:12.80,Subaru,Subaru,0,0,0,,Sürüngen!
Dialogue: 0,0:10:35.86,0:10:37.70,Subaru,Subaru,0,0,0,,Nesin?..
Dialogue: 0,0:10:40.03,0:10:43.22,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Sen... {\alpha&HFF&\t(1780,1,\alpha&H00&)}neyin nesisin?..
Dialogue: 0,0:10:45.37,0:10:48.99,main,Voice,0,0,0,,{\3c&H2F2F98&\4c&H2B2BBF&}Bir dahakine iyi tahmin et...
Dialogue: 0,0:10:48.99,0:10:50.76,main,Voice,0,0,0,,{\3c&H2F2F98&\4c&H2B2BBF&}kahraman~
Dialogue: 0,0:10:57.41,0:10:58.43,Emilia,Emilia,0,0,0,,Subaru!
Dialogue: 0,0:10:59.13,0:11:01.51,Emilia,Emilia,0,0,0,,Sana diyorum, Subaru! İyi misin?
Dialogue: 0,0:11:01.92,0:11:04.31,Subaru,Subaru,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}Emi{\alpha&HFF&\t(1450,1,\alpha&H00&)}lia...
Dialogue: 0,0:11:04.67,0:11:06.58,Emilia,Emilia,0,0,0,,Şükürler olsun iyisin!
Dialogue: 0,0:11:06.58,0:11:08.82,Emilia,Emilia,0,0,0,,Çook endişelenmiştim!
Dialogue: 0,0:11:13.29,0:11:13.98,Emilia,Emilia,0,0,0,,Subaru?
Dialogue: 0,0:11:15.62,0:11:16.73,Emilia,Emilia,0,0,0,,Ne oldu?
Dialogue: 0,0:11:19.07,0:11:21.52,Beatrice,Beatrice,0,0,0,,Uyku sersemi sanırım.
Dialogue: 0,0:11:21.52,0:11:25.32,Beatrice,Beatrice,0,0,0,,Betty'leri endişelendirdikten\Nsonra epey bir rahat gibisin.
Dialogue: 0,0:11:27.36,0:11:28.42,Subaru,Subaru,0,0,0,,Sen!..
Dialogue: 0,0:11:30.96,0:11:33.44,Beatrice,Beatrice,0,0,0,,Nedense bu pek hoşuma gitmedi, sanırım!
Dialogue: 0,0:11:33.44,0:11:37.09,Beatrice,Beatrice,0,0,0,,Seni bulmak, Betty ve Emilia'nın başarısıydı.
Dialogue: 0,0:11:38.18,0:11:39.51,Emilia,Emilia,0,0,0,,Somurtma hemen.
Dialogue: 0,0:11:39.51,0:11:43.86,Emilia,Emilia,0,0,0,,Ne olacak sanki? Subaru ve Patrasche-chan\Nbak ne güzel anlaşıyorlar.
Dialogue: 0,0:11:47.04,0:11:48.14,Emilia,Emilia,0,0,0,,Baksana, Subaru...
Dialogue: 0,0:11:48.49,0:11:50.60,Emilia,Emilia,0,0,0,,Gerçekten kendini iyi hissediyor musun?
Dialogue: 0,0:11:50.60,0:11:54.44,Subaru,Subaru,0,0,0,,Evet, iyiyim iyiyim. Sorun yok.
Dialogue: 0,0:11:54.44,0:11:56.61,Subaru,Subaru,0,0,0,,Muhtemelen yorgunluğumun sınırındaydım.
Dialogue: 0,0:11:56.83,0:11:59.19,Subaru,Subaru,0,0,0,,Uyuyakalmak her zaman\Nolan bir şey ne de olsa.
Dialogue: 0,0:11:59.59,0:12:00.53,Emilia,Emilia,0,0,0,,Anladım...
Dialogue: 0,0:12:01.00,0:12:03.32,Emilia,Emilia,0,0,0,,Ama yorulduysan dürüstçe söyle, tamam mı?
Dialogue: 0,0:12:03.66,0:12:05.63,Emilia,Emilia,0,0,0,,Kendini zorlamaktan kaçınmalısın çünkü.
Dialogue: 0,0:12:09.49,0:12:11.58,Subaru,Subaru INT,0,0,0,,{\i1}Fazlasıyla riskli olacak lakin...
Dialogue: 0,0:12:11.58,0:12:15.04,Subaru,Subaru INT,0,0,0,,{\i1}bu sefer hafıza kaybımdan\Nbahsetmeden ilerleyeceğim.
Dialogue: 0,0:12:15.52,0:12:20.20,Subaru,Subaru INT,0,0,0,,{\i1}Öldürülme sebebim ve hafıza kaybımın\Nbağlantılı olup olmadığını doğrulamak istiyorum.
Dialogue: 0,0:12:20.20,0:12:25.79,Subaru,Subaru INT,0,0,0,,{\i1}Dürüst olmak gerekirse, birinin bir şeyi\Nhatırlamasını istemediğin için öldürebilecek olsan da...
Dialogue: 0,0:12:25.79,0:12:29.89,Subaru,Subaru INT,0,0,0,,{\i1}bir şeyi unuttum diye öldürülmek\Npek aklıma yatmıyor.
Dialogue: 0,0:12:32.58,0:12:33.69,Emilia,Emilia,0,0,0,,Subaru.
Dialogue: 0,0:12:34.20,0:12:36.90,Emilia,Emilia,0,0,0,,Yine alnın kırışıyor.
Dialogue: 0,0:12:38.52,0:12:42.51,Subaru,Subaru,0,0,0,,Bu kızla bu kadar yakınlaşacağım\Nne olmuş olabilir ki?..
Dialogue: 0,0:12:44.86,0:12:49.08,Subaru,Subaru INT,0,0,0,,O ikisinin cesedini bulamadım ama...
Dialogue: 0,0:12:49.08,0:12:52.45,main,Voice FB,0,0,0,,{\3c&H2F2F98&\4c&H2B2BBF&}Bir dahakine iyi tahmin et...
Dialogue: 0,0:12:52.77,0:12:54.37,main,Voice FB,0,0,0,,{\3c&H2F2F98&\4c&H2B2BBF&}kahraman~
Dialogue: 0,0:12:55.00,0:12:57.87,Subaru,Subaru INT,0,0,0,,O ses, ikisine de ait değildi.
Dialogue: 0,0:12:58.02,0:13:00.22,Subaru,Subaru INT,0,0,0,,Aslında, buradaki kimsenin—
Dialogue: 0,0:13:00.22,0:13:00.87,Ram,Ram,0,0,0,,Barusu.
Dialogue: 0,0:13:03.28,0:13:06.32,Ram,Ram,0,0,0,,Rüya âleminden çık da su\Ntaşımama bari yardım et.
Dialogue: 0,0:13:06.32,0:13:08.34,Ram,Ram,0,0,0,,Aman, pardon.
Dialogue: 0,0:13:08.34,0:13:10.18,Ram,Ram,0,0,0,,Yukarıdaki arşivde uyuduğunu duydum.
Dialogue: 0,0:13:10.79,0:13:13.42,Ram,Ram,0,0,0,,Fazla aptalca hareketlerden kaçın.
Dialogue: 0,0:13:13.42,0:13:15.27,Ram,Ram,0,0,0,,Etrafındakilere sorun çıkarıyorsun.
Dialogue: 0,0:13:15.63,0:13:18.01,Subaru,Subaru,0,0,0,,Biliyorum, pişmanım.
Dialogue: 0,0:13:18.01,0:13:20.63,Subaru,Subaru,0,0,0,,Seni de endişelendirdiğim\Niçin özür dilerim.
Dialogue: 0,0:13:20.63,0:13:23.02,Ram,Ram,0,0,0,,Ben senin için endişelenecek miyim?\NNe sebeple?
Dialogue: 0,0:13:23.02,0:13:24.86,Subaru,Subaru,0,0,0,,Güvenliğim için falan?..
Dialogue: 0,0:13:25.52,0:13:27.96,Shaula,Shaula,0,0,0,,Günaydııın, Usta~!
Dialogue: 0,0:13:28.18,0:13:30.47,Shaula,Shaula,0,0,0,,Dün gece rahat uyudun mu bari~?
Dialogue: 0,0:13:32.62,0:13:35.41,Shaula,Shaula,0,0,0,,Beni sorarsan harika uyudum!
Dialogue: 0,0:13:35.41,0:13:37.77,Shaula,Shaula,0,0,0,,Eskilerden bi' rüya falan da gördüm!
Dialogue: 0,0:13:37.97,0:13:41.63,Shaula,Shaula,0,0,0,,Ben, sen, annem, bi' dee...
Dialogue: 0,0:13:41.88,0:13:45.23,Subaru,Subaru,0,0,0,,Ah, tamam tamam.\NSonra iyice dinlerim.
Dialogue: 0,0:13:45.23,0:13:49.40,Subaru,Subaru,0,0,0,,Bu arada sen, sabahki beni\Ngörünce bir farklılık sezdin mi?
Dialogue: 0,0:13:49.40,0:13:51.48,Shaula,Shaula,0,0,0,,Sabahki Ustam mı?
Dialogue: 0,0:13:51.48,0:13:53.78,Shaula,Shaula,0,0,0,,Her zamanki gibi çekiciydin!
Dialogue: 0,0:13:53.98,0:13:56.05,Shaula,Shaula,0,0,0,,Teklif etmek için 400 yıldır bekliyordum~!
Dialogue: 0,0:13:56.33,0:13:58.36,Subaru,Subaru,0,0,0,,Amma sabır işiymiş.
Dialogue: 0,0:13:58.36,0:14:00.64,Subaru,Subaru,0,0,0,,Bir şey yoksa iyi bari.
Dialogue: 0,0:14:00.64,0:14:01.80,Shaula,Shaula,0,0,0,,Öyle mi?
Dialogue: 0,0:14:14.79,0:14:17.18,Subaru,Subaru,0,0,0,,Shaula, senden bir isteğim olacak.
Dialogue: 0,0:14:17.18,0:14:19.25,Shaula,Shaula,0,0,0,,He? Neymiş?
Dialogue: 0,0:14:20.78,0:14:21.71,Subaru,Subaru,0,0,0,,Julius.
Dialogue: 0,0:14:23.42,0:14:25.92,Subaru,Subaru,0,0,0,,Dün gece hakkında konuşmak istiyorum.
Dialogue: 0,0:14:26.48,0:14:28.35,Subaru,Subaru,0,0,0,,Sadece ikimiz ama.
Dialogue: 0,0:14:31.79,0:14:34.39,Julius-Anastasia,Julius,0,0,0,,Dün gece hakkında mı?
Dialogue: 0,0:14:34.96,0:14:38.01,Julius-Anastasia,Julius,0,0,0,,O muhabbet orada kapandı sanıyordum.
Dialogue: 0,0:14:38.01,0:14:39.69,Julius-Anastasia,Julius,0,0,0,,Senin için kapanmadı sanırım.
Dialogue: 0,0:14:39.69,0:14:41.35,Subaru,Subaru,0,0,0,,Evet, kapanmadı.
Dialogue: 0,0:14:41.35,0:14:44.86,Subaru,Subaru,0,0,0,,Hiç mi hiç tatmin olmadım.
Dialogue: 0,0:14:48.24,0:14:50.78,Julius-Anastasia,Julius,0,0,0,,Tatmin demek...
Dialogue: 0,0:14:50.78,0:14:53.03,Julius-Anastasia,Julius,0,0,0,,Anlıyorum. Tam senlik.
Dialogue: 0,0:14:53.85,0:14:56.88,Julius-Anastasia,Julius,0,0,0,,Lakin bunun fazlasıyla bencilce\Nolduğunu düşünmüyor musun?
Dialogue: 0,0:14:56.88,0:15:00.06,Subaru,Subaru,0,0,0,,Sen de pek tatmin olmuş gibi\Nbakmıyordun herhâlde.
Dialogue: 0,0:15:00.06,0:15:03.55,Subaru,Subaru,0,0,0,,İkimizin de canını sıkan bir şey varken...
Dialogue: 0,0:15:03.73,0:15:05.65,Subaru,Subaru,0,0,0,,otur kıçının üstüne mi diyorsun?
Dialogue: 0,0:15:05.65,0:15:07.31,Subaru,Subaru,0,0,0,,Yapardım sanki.
Dialogue: 0,0:15:07.31,0:15:10.80,Julius-Anastasia,Julius,0,0,0,,O hâlde başka ne seçeneğimiz var ki?
Dialogue: 0,0:15:11.44,0:15:14.47,Julius-Anastasia,Julius,0,0,0,,Hislerim, dün gecekiyle aynı.
Dialogue: 0,0:15:14.47,0:15:17.19,Julius-Anastasia,Julius,0,0,0,,Dilim de daha ötesine varmaz.
Dialogue: 0,0:15:17.76,0:15:21.54,Julius-Anastasia,Julius,0,0,0,,Senin Anastasia-sama'yla,\NEchidna'yla olan sırrını...
Dialogue: 0,0:15:21.54,0:15:23.90,Julius-Anastasia,Julius,0,0,0,,zerre fark edemedim zira.
Dialogue: 0,0:15:24.52,0:15:27.48,Subaru,Subaru,0,0,0,,Benim ve Echidna'nın sırrı mı?
Dialogue: 0,0:15:27.48,0:15:30.54,Julius-Anastasia,Julius,0,0,0,,Kötü bir amaç gütmediğinin bilincindeyim.
Dialogue: 0,0:15:31.22,0:15:34.86,Julius-Anastasia,Julius,0,0,0,,Echidna'yla da yeterli diyemesem de konuştum.
Dialogue: 0,0:15:34.86,0:15:36.64,Julius-Anastasia,Julius,0,0,0,,O güvenilir biri.
Dialogue: 0,0:15:37.12,0:15:40.52,Julius-Anastasia,Julius,0,0,0,,Hayır, ona güvenmekten başka çarem yok.
Dialogue: 0,0:15:41.20,0:15:43.63,Julius-Anastasia,Julius,0,0,0,,Anastasia-sama'yı kurtarmak için...
Dialogue: 0,0:15:43.63,0:15:46.34,Julius-Anastasia,Julius,0,0,0,,bu ihtimalin üstüne oynamam gerek.
Dialogue: 0,0:15:48.64,0:15:50.32,Julius-Anastasia,Julius,0,0,0,,Geri geldiğinde...
Dialogue: 0,0:15:50.98,0:15:54.14,Julius-Anastasia,Julius,0,0,0,,o şahsiyet beni hatırlamayacak olsa dahi...
Dialogue: 0,0:15:54.95,0:15:56.86,Subaru,Subaru,0,0,0,,Nasıl... yani?
Dialogue: 0,0:15:58.03,0:15:59.03,Julius-Anastasia,Julius,0,0,0,,Şakayı bırak...
Dialogue: 0,0:15:59.92,0:16:03.34,Julius-Anastasia,Julius,0,0,0,,Önünde beni daha da acınası\Nbir duruma düşürme lütfen.
Dialogue: 0,0:16:07.83,0:16:11.78,Julius-Anastasia,Julius,0,0,0,,Dün gece diyince biraz korkmuştum.
Dialogue: 0,0:16:12.32,0:16:15.80,Julius-Anastasia,Julius,0,0,0,,Benden özür dilersen ne yapacağım diye.
Dialogue: 0,0:16:16.25,0:16:19.75,Subaru,Subaru,0,0,0,,Özür dilersem mi?
Dialogue: 0,0:16:20.07,0:16:24.26,Julius-Anastasia,Julius,0,0,0,,O vakit, sana ne yanıt verirdim acaba?
Dialogue: 0,0:16:25.03,0:16:28.13,Julius-Anastasia,Julius,0,0,0,,Bunu da artık bilemeyiz gerçi.
Dialogue: 0,0:16:43.56,0:16:46.73,Shaula,Shaula,0,0,0,,Usta, bu şekilde mutlu musun?
Dialogue: 0,0:16:47.05,0:16:48.42,Subaru,Subaru,0,0,0,,Evet.
Dialogue: 0,0:16:48.42,0:16:52.24,Subaru,Subaru,0,0,0,,Dediklerinden yola çıkarsak,\NJulius'un arşivle bir alakası yok.
Dialogue: 0,0:16:52.24,0:16:56.26,Subaru,Subaru,0,0,0,,Sadece dünkü ben\Nhakkında şüpheleri arttı.
Dialogue: 0,0:16:56.26,0:16:58.12,Shaula,Shaula,0,0,0,,Pek anlamasam da...
Dialogue: 0,0:16:58.50,0:17:00.74,Shaula,Shaula,0,0,0,,senin işine yaradım mı Usta?
Dialogue: 0,0:17:01.08,0:17:02.75,Subaru,Subaru,0,0,0,,Evet, yaradın yaradın.
Dialogue: 0,0:17:03.23,0:17:08.00,Subaru,Subaru,0,0,0,,Senin yanımda olman sayende,\Nrahatça Julius'la yüzleşebildim.
Dialogue: 0,0:17:10.06,0:17:11.87,Shaula,Shaula,0,0,0,,E iyi o zaman!
Dialogue: 0,0:17:12.34,0:17:14.76,Shaula,Shaula,0,0,0,,O zamaaan, Usta Ustaa...
Dialogue: 0,0:17:14.76,0:17:18.64,Shaula,Shaula,0,0,0,,ödül olarak bana sıımsıkı sarıl~!
Dialogue: 0,0:17:18.76,0:17:19.38,Subaru,Subaru,0,0,0,,Bak o olmaz.
Dialogue: 0,0:17:19.38,0:17:21.37,Shaula,Shaula,0,0,0,,Yaa! Çok kırıcısın!
Dialogue: 0,0:17:21.37,0:17:24.16,Shaula,Shaula,0,0,0,,Usta! Ödül sınırı aşmadığı sürece...
Dialogue: 0,0:17:24.16,0:17:27.03,Shaula,Shaula,0,0,0,,ne istersem yapacağını söyledin!
Dialogue: 0,0:17:27.03,0:17:29.38,Subaru,Subaru,0,0,0,,O istek benim kişisel sınırlarımı aşıyor.
Dialogue: 0,0:17:31.36,0:17:38.36,Subaru,Subaru,0,0,0,,İşin sonunda; sen ne halt ettin de kimin\Nhedefi hâline geldin, Natsuki Subaru?
Dialogue: 0,0:17:39.10,0:17:41.47,Subaru,Subaru,0,0,0,,Kafam durdu.
Dialogue: 0,0:17:41.47,0:17:43.71,Subaru,Subaru,0,0,0,,Patrasche'tan tavsiye isteyecek gibiyim.
Dialogue: 0,0:17:43.71,0:17:46.08,Shaula,Shaula,0,0,0,,Neee? Yer ejderinden mi?
Dialogue: 0,0:17:46.08,0:17:48.53,Shaula,Shaula,0,0,0,,Bana ters ters baktığı için onu sevmiyorum.
Dialogue: 0,0:17:48.53,0:17:51.91,Subaru,Subaru,0,0,0,,Hoop! Patrasche'ın arkasından attırmam!
Dialogue: 0,0:17:51.91,0:17:54.95,Subaru,Subaru,0,0,0,,Bu dünyada herkesin arkasından\Natabilecek olsan...
Dialogue: 0,0:17:54.95,0:17:57.55,Subaru,Subaru,0,0,0,,Patrasche'ın arkasından\Nyine laf söyletmem!
Dialogue: 0,0:17:57.55,0:18:01.58,Shaula,Shaula,0,0,0,,Usta, o yer ejderini ne kadar seviyorsun?
Dialogue: 0,0:18:01.76,0:18:05.42,Subaru,Subaru,0,0,0,,Bu yüzden de senle ben burada ayrılıyoruz.
Dialogue: 0,0:18:05.42,0:18:06.56,Subaru,Subaru,0,0,0,,Sonra görüşürüz.
Dialogue: 0,0:18:06.56,0:18:10.39,Shaula,Shaula,0,0,0,,Ama yaa! Ödülümü de hiç ettin!
Dialogue: 0,0:18:10.39,0:18:12.69,Shaula,Shaula,0,0,0,,Ama yılmayacağım!
Dialogue: 0,0:18:12.69,0:18:17.54,Shaula,Shaula,0,0,0,,"Ustamın işine yarayacak bir kadın olmak"\Nyaşama sebebim sonuçta!
Dialogue: 0,0:18:19.45,0:18:24.29,Subaru,Subaru,0,0,0,,O kadar değer, Natsuki\NSubaru'nun neresinde var?
Dialogue: 0,0:18:25.58,0:18:26.75,Shaula,Shaula,0,0,0,,Usta?
Dialogue: 0,0:18:26.75,0:18:28.21,Subaru,Subaru,0,0,0,,Ah, hay ama ya!
Dialogue: 0,0:18:34.13,0:18:38.56,Subaru,Subaru,0,0,0,,İşime yarayacak bir kadın\Nolmayı falan kafaya takma.
Dialogue: 0,0:18:38.56,0:18:40.11,Subaru,Subaru,0,0,0,,Hata bende.
Dialogue: 0,0:18:42.27,0:18:43.70,Shaula,Shaula,0,0,0,,Usta...
Dialogue: 0,0:18:47.53,0:18:51.47,Subaru,Subaru,0,0,0,,Burada olman çok iyi oldu. Bu kadar.
Dialogue: 0,0:18:52.86,0:18:54.10,Shaula,Shaula,0,0,0,,Usta...
Dialogue: 0,0:18:55.78,0:18:56.77,Shaula,Shaula,0,0,0,,Sonunda...
Dialogue: 0,0:18:57.57,0:19:01.24,Shaula,Shaula,0,0,0,,{\alpha&HFF&\t(0,1,\alpha&H00&)}beni... {\alpha&HFF&\t(2200,1,\alpha&H00&)}şeviyoy muşuuun~?!
Dialogue: 0,0:19:02.14,0:19:03.77,Subaru,Subaru,0,0,0,,Kişisel sınır!
Dialogue: 0,0:19:16.55,0:19:19.30,Subaru,Subaru,0,0,0,,Hepsinin tavırları yapmacıksa...
Dialogue: 0,0:19:19.30,0:19:22.21,Subaru,Subaru,0,0,0,,Artık neye inanacağımı şaşırdım.
Dialogue: 0,0:19:25.68,0:19:29.35,Subaru,Subaru,0,0,0,,Görünüşe göre, güvenebileceğim\Ntek kişi Patrasche.
Dialogue: 0,0:19:30.58,0:19:34.91,Subaru,Subaru,0,0,0,,Ömür boyu Patrasche'la birlikte bir\Ncennette yaşasam çok mutlu olur—
Dialogue: 0,0:19:34.91,0:19:36.98,Roswaal,Meili,0,0,0,,Aah ah, duydum gitti.
Dialogue: 0,0:19:36.98,0:19:37.57,Subaru,Subaru,0,0,0,,Ney?!
Dialogue: 0,0:19:39.78,0:19:43.92,Roswaal,Meili,0,0,0,,Abi, demek Patrasche-chan'la\Nuzaklara kaçmak istiyorsun.
Dialogue: 0,0:19:43.92,0:19:47.77,Roswaal,Meili,0,0,0,,Bunu duyarlarsa Beatrice-chan\Nve ablam göz yaşlarına boğulur.
Dialogue: 0,0:19:48.09,0:19:50.00,Subaru,Subaru,0,0,0,,Bok gibi bir şakaydı o kadar.
Dialogue: 0,0:19:50.34,0:19:52.35,Subaru,Subaru,0,0,0,,Her anlamda kafandan sil lütfen.
Dialogue: 0,0:19:52.35,0:19:54.16,Roswaal,Meili,0,0,0,,Tabii tabii~
Dialogue: 0,0:19:54.16,0:19:58.76,Roswaal,Meili,0,0,0,,Ama bunlar gerçek hislerin\Nbile olsa sana gülmezdim.
Dialogue: 0,0:19:59.16,0:20:03.51,Roswaal,Meili,0,0,0,,Ben de hep canavarcıklarla\Nyaşamıştım ya hani?
Dialogue: 0,0:20:03.51,0:20:05.10,Subaru,Subaru,0,0,0,,Canavarcık...
Dialogue: 0,0:20:05.84,0:20:08.41,Subaru,Subaru,0,0,0,,Kurtların yetiştirdiği kız gibi mi?
Dialogue: 0,0:20:09.91,0:20:12.23,Roswaal,Meili,0,0,0,,Bunu dün de söylemiştin.
Dialogue: 0,0:20:12.68,0:20:14.80,Roswaal,Meili,0,0,0,,Annem çok katıydı.
Dialogue: 0,0:20:14.80,0:20:19.00,Roswaal,Meili,0,0,0,,Ayrıca peşinde dört dolandığım\NElsa da fazla gevşek olduğundan...
Dialogue: 0,0:20:19.00,0:20:21.96,Roswaal,Meili,0,0,0,,çoğu şeyi kendim yapmam gerekiyordu.
Dialogue: 0,0:20:21.96,0:20:25.50,Subaru,Subaru,0,0,0,,Hop, yavaş ol! Art arda\Nhepsi kafamı patlatacak!
Dialogue: 0,0:20:25.50,0:20:27.24,Subaru,Subaru,0,0,0,,Şu an meşgulüm.
Dialogue: 0,0:20:27.24,0:20:29.13,Subaru,Subaru,0,0,0,,Shaula'yla falan oyna lütfen.
Dialogue: 0,0:20:29.36,0:20:31.03,Roswaal,Meili,0,0,0,,Yarı cıbıl ablayla mı?
Dialogue: 0,0:20:31.03,0:20:32.69,Roswaal,Meili,0,0,0,,O da olur da...
Dialogue: 0,0:20:32.92,0:20:35.21,Roswaal,Meili,0,0,0,,şu an seninle işim var, abi.
Dialogue: 0,0:20:35.75,0:20:37.04,Subaru,Subaru,0,0,0,,Benimle mi?
Dialogue: 0,0:20:46.00,0:20:48.35,Roswaal,Meili,0,0,0,,Dün gece konusunda...
Dialogue: 0,0:20:48.35,0:20:51.56,Roswaal,Meili,0,0,0,,ne kadarını ciddiye almalıyım~?
Dialogue: 0,0:21:01.19,0:21:02.97,Subaru,Subaru,0,0,0,,Bu da ne?
Dialogue: 0,0:21:12.85,0:21:14.16,Subaru,Subaru,0,0,0,,Şaka mı?
Dialogue: 0,0:21:15.12,0:21:17.03,Subaru,Subaru,0,0,0,,Şaka! Şaka! Şaka olmalı!
Dialogue: 0,0:21:17.03,0:21:17.83,Subaru,Subaru,0,0,0,,Şaka olmalı!
Dialogue: 0,0:21:18.38,0:21:19.26,Subaru,Subaru,0,0,0,,Meili!
Dialogue: 0,0:21:19.26,0:21:21.05,Subaru,Subaru,0,0,0,,Hey! Meili!
Dialogue: 0,0:21:22.88,0:21:24.38,Subaru,Subaru,0,0,0,,Meili! Meili!
