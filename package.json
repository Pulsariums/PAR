{
  "name": "pulsar-ass-renderer",
  "version": "0.1.0",
  "description": "PAR (Pulsar ASS Renderer): a dependency-free, plug-and-play ASS/SSA subtitle renderer for the browser (DOM/SVG/CSS).",
  "license": "MIT",
  "author": "Pulsariums",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/par.cjs",
  "module": "./dist/par.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/par.global.js",
  "jsdelivr": "./dist/par.global.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/par.js",
      "require": "./dist/par.cjs"
    },
    "./global": "./dist/par.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ass",
    "ssa",
    "subtitle",
    "subtitles",
    "renderer",
    "libass",
    "karaoke",
    "video",
    "fansub"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pulsariums/pulsar-ass-renderer.git"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
