{
  "name": "pulsar-ass-renderer",
  "version": "0.1.0",
  "description": "PAR (Pulsar ASS Renderer): a dependency-free, plug-and-play ASS/SSA subtitle renderer for the browser (DOM/SVG/CSS).",
  "license": "MIT",
  "author": "Pulsariums",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/par.cjs",
  "module": "./dist/par.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/par.global.js",
  "jsdelivr": "./dist/par.global.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/par.js",
      "require": "./dist/par.cjs"
    },
    "./fontlib": {
      "types": "./dist/types/fontlib/index.d.ts",
      "import": "./dist/fontlib.js",
      "require": "./dist/fontlib.cjs"
    },
    "./source": {
      "types": "./dist/types/source/index.d.ts",
      "import": "./dist/source.js",
      "require": "./dist/source.cjs"
    },
    "./optimize": {
      "types": "./dist/types/optimize/index.d.ts",
      "import": "./dist/optimize.js",
      "require": "./dist/optimize.cjs"
    },
    "./analyze": {
      "types": "./dist/types/analyze/index.d.ts",
      "import": "./dist/analyze.js",
      "require": "./dist/analyze.cjs"
    },
    "./worker": "./dist/source.worker.js",
    "./global": "./dist/par.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.tr.md",
    "README.ru.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ass",
    "ssa",
    "subtitle",
    "subtitles",
    "renderer",
    "libass",
    "karaoke",
    "video",
    "fansub",
    "advanced-substation-alpha",
    "html5-video",
    "dom",
    "svg",
    "typescript",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pulsariums/PAR.git"
  },
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build && vite build --config vite.fontlib.config.ts && vite build --config vite.source.config.ts && vite build --config vite.worker.config.ts && vite build --config vite.optimize.config.ts && vite build --config vite.analyze.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "xpar": "node tools/xpar/run.mjs cli",
    "xpar:bench": "node tools/xpar/run.mjs bench",
    "xpar:gen": "node tools/xpar/run.mjs gen-bench",
    "build:site": "vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts --port 4173"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://pulsariums.github.io/PAR/",
  "bugs": {
    "url": "https://github.com/Pulsariums/PAR/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
